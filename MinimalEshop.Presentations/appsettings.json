          "rollingInterval": "Day", // after each day a new log file is created
          "fileSizeLimitBytes": 1048576, // file size is limited to 1MB 
          "rollOnFileSizeLimit": true // with this the new file is created after the 1MB limit exceed.
        }
      },
      {
        "Name": "MongoDB",
        "Args": {
          "databaseUrl": "mongodb+srv://Sharanya:Sharanya@cluster0.m2cqpvh.mongodb.net/CRUDLogs",
          "collectionName": "logs",
          "capped": false,
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
